# ===============================================================
#  Unity 工程根 .gitignore
#  repo root = 工程根 "My project (2)"
#
#  仓库定位：只收【代码】.py / .cs 与【文档】.md
#  其余 Unity 元素、第三方二进制、数据集、缓存一律不入库
# ===============================================================

# ---- Unity 自动生成 / 缓存 ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Uu]serSettings/

# ---- Unity 工程元素 ----
/ProjectSettings/
/Packages/
/Assets/Scenes/
/Assets/Resources/
/Assets/Plugins/
/Assets/StreamingAssets/
/Assets/AssetStoreTools/
*.meta
*.unity
*.mat
*.renderTexture
*.shader
*.asset
*.prefab
*.controller
*.anim
*.cubemap
*.jpg
*.jpeg
*.png
*.gif
*.tga
*.psd
*.wav
*.mp3
*.fbx

# ---- 第三方二进制 ----
*.dll
*.so
*.dylib
*.pdb
*.mdb

# ---- 数据 / 记录（本地保留，不入库）----
*.json
*.txt
*.npz
*.npy
*.csv

# ---- IDE / 编辑器 ----
/.vs/
/.idea/
/.vscode/
/.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.sln.DotSettings.user
/app.config
/packages.config

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.log

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 构建产物 ----
*.apk
*.aab
*.app
*.unitypackage
ExportedObj/
